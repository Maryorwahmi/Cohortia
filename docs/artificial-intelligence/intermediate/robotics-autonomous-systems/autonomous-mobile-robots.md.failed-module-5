    # Calculate linear wheel speeds
    v_L = v - (omega * L / 2.0)
    v_R = v + (omega * L / 2.0)

    # Convert linear speeds to angular velocities
    omega_L = v_L / r
    omega_R = v_R / r
    return omega_L, omega_R

