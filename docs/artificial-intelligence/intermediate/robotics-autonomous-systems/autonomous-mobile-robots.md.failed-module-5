    ax.set_aspect('equal', adjustable='box')
    ax.set_xlim(-L - R/2, L + R/2)
    ax.set_ylim(-T - R/2, T + R/2)
    ax.set_xlabel("X (m)")
    ax.set_ylabel("Y (m)")
    ax.set_title(f"Ackerman Steering (R={R:.2f}m)")
    ax.grid(True)
    ax.legend()

