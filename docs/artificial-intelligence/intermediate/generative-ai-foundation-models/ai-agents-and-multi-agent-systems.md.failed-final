    "action": "analyze_logs",
    "parameters": {
        "log_path": "/var/log/app.log",
        "error_types": ["CRITICAL", "ERROR"],
        "report_format": "JSON"
    }
}

# Construct the FIPA ACL message
fipa_request_message = {
    # Your code here: Fill in the performative, sender, receiver, content, language, ontology, and reply-with
    "performative": "...",
    "sender": "...",
    "receiver": "...",
    "content": ...,
    "language": "...",
    "ontology": "...",
