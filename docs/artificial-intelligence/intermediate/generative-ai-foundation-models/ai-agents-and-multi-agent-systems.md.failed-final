    "performative": "request",
    "sender": "task_initiator@enterprise_domain",
    "receiver": "task_executor@enterprise_domain",
    "content": {
        "action": "analyze_logs",
        "parameters": {
            "log_path": "/var/log/app.log",
            "error_types": ["CRITICAL", "ERROR"],
            "report_format": "JSON"
        }
    },
    "language": "JSON",
