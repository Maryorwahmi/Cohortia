{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cohortia Course & Career Catalog Schema",
  "description": "Schema for curated courses, certificates, and degrees that can be offered as careers inside Cohortia.",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "description": "Top-level category, e.g. Computer Science, Business, Health."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "sourceNote": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "provider", "platform", "level", "type", "skills"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable unique identifier, e.g. cs-fullstack-meta-001"
          },
          "title": {
            "type": "string"
          },
          "subcategory": {
            "type": "string",
            "description": "Sub-field inside the category, e.g. Web Development, Cybersecurity."
          },
          "provider": {
            "type": "string",
            "description": "Organization that created the content/credential, e.g. Meta, Google, Harvard."
          },
          "platform": {
            "type": "string",
            "description": "Where it is hosted, e.g. Coursera, Udemy, edX, University direct."
          },
          "level": {
            "type": "string",
            "enum": ["Beginner", "Intermediate", "Advanced"]
          },
          "type": {
            "type": "string",
            "enum": ["Course", "Certificate", "Professional Certificate", "Diploma", "Bachelor", "Master", "Doctorate"]
          },
          "delivery": {
            "type": "string",
            "enum": ["Online", "In-Person", "Hybrid", "Self-Paced"]
          },
          "duration": {
            "type": "string",
            "description": "Human-readable duration, e.g. '6 months', 'Exam', '4 years'."
          },
          "description": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of key skills/topics the learner will gain."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Search/discovery tags, e.g. 'AI', 'cloud', 'entry-level'."
          },
          "prerequisites": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string",
            "description": "Any extra context, exam codes, or verification notes."
          }
        }
      }
    }
  }
}
