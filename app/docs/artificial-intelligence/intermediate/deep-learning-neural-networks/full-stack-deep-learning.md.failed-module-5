    services:
      model_server:
        build: .
        ports:
          - "5000:5000"
        environment:
          FLASK_RUN_PORT: 5000
        depends_on:
          - redis_cache # Our model server doesn't use redis yet, but demonstrates dependency

      redis_cache:
        image: redis:6-alpine
        ports:
          - "6379:6379"
        command: redis-server --appendonly yes
        volumes:
          - redis_data:/data

    volumes:
      redis_data:
    ```

**Instructions:**
1.  **Start the services:**
    ```bash
