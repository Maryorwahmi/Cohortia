pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    AUTOMATION_API_URL = 'https://cohortia.onrender.com'
    AUTOMATION_WORKER_TOKEN = credentials('cohortia-automation-worker-token')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[url: 'https://github.com/Maryorwahmi/Cohortia.git']],
          extensions: [
            [$class: 'CloneOption', depth: 1, noTags: true, shallow: true, timeout: 20],
            [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [[path: 'app']]],
          ],
        ])
      }
    }

    stage('Install dependencies') {
      steps {
        dir('app') {
          script {
            if (isUnix()) {
              sh 'node --version && npm --version && npm ci --include-workspace-root'
            } else {
              bat 'node --version && npm --version && npm ci --include-workspace-root'
            }
          }
        }
      }
    }

    stage('Process automation queue') {
      steps {
        dir('app') {
          script {
            if (isUnix()) {
              sh 'node scripts/run-jenkins-automation.js'
            } else {
              bat 'node scripts/run-jenkins-automation.js'
            }
          }
        }
      }
    }
  }
}