FROM node:22-bookworm-slim

WORKDIR /app
COPY package*.json ./
COPY backend/package*.json backend/
RUN npm install --omit=dev --ignore-scripts --workspaces=false
RUN npm --prefix backend install --omit=dev --ignore-scripts

COPY docs ./docs
COPY scripts ./scripts
COPY backend/scripts ./backend/scripts
COPY backend/src/lib ./backend/src/lib
COPY scripts/run-azure-automation.js ./scripts/run-azure-automation.js
CMD ["node", "scripts/run-azure-automation.js"]
