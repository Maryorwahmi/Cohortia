{
  "name": "cohortia-app",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Cohortia frontend and backend application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "typecheck": "npm --prefix frontend run typecheck",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "practicals:normalize": "node scripts/normalize-hands-on-activities.js",
    "practicals:pilot": "node scripts/generate-cs50-practical-pilot.js"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  }
}
