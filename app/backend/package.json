{
  "name": "cohortia-backend",
  "version": "1.0.0",
  "description": "Cohortia backend API built with Hono",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node --check src/index.js",
    "start": "node src/index.js",
    "start:automation-worker": "node src/automation-worker.js",
    "db:push": "npx --no-install drizzle-kit push",
    "db:migrate-schema": "node migrate-schema.js",
    "db:migrate-dashboard-indexes": "node scripts/migrate-dashboard-indexes.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.js",
    "db:studio": "npx --no-install drizzle-kit studio",
    "db:generate": "npx --no-install drizzle-kit generate",
    "db:sync-local-to-turso": "node scripts/sync-local-db-to-turso.js --apply",
    "db:import-local-runtime": "node scripts/import-local-runtime-data.js",
    "db:import-all-to-turso": "node scripts/import-all-to-turso.js",
    "db:seed": "node src/seed.js",
    "db:import-catalog": "node scripts/import-catalog-courses.js",
    "db:classify-course-levels": "node scripts/classify-catalog-course-levels.js --apply",
    "db:apply-course-level-inferences": "node scripts/apply-catalog-course-level-inferences.js",
    "test:course-levels": "node --test scripts/course-levels.test.js",
    "test:newsletter": "node --test scripts/newsletter-brevo.test.js",
    "test:session-auth": "node --test scripts/session-auth.test.js",
    "test:oauth-state": "node --test scripts/oauth-state.test.js",
    "test:rate-limits": "node --test scripts/rate-limit.test.js",
    "test:practical-grading": "node --test scripts/practical-grading.test.js",
    "db:import-learning-boards": "node scripts/import-learning-boards.js",
    "db:migrate-learning-board-screen-index": "node scripts/migrate-learning-board-screen-index.js",
    "test:learning-board-screen-upsert": "node --test scripts/learning-board-screen-upsert.test.js",
    "test:gemini-rotation": "node --test scripts/gemini-rotation.test.js",
    "db:import-hands-on-activities": "node scripts/import-hands-on-activities.js",
    "db:migrate-practical-identity": "node scripts/migrate-practical-identity.js",
    "db:verify-terminal-coding-lab-phase0": "node scripts/verify-terminal-coding-lab-phase0.js",
    "db:verify-terminal-coding-lab-phase1": "node scripts/verify-terminal-coding-lab-phase1.js",
    "db:verify-terminal-coding-lab-phase2": "node scripts/verify-terminal-coding-lab-phase2.js",
    "db:verify-terminal-coding-lab-phase3": "node scripts/verify-terminal-coding-lab-phase3.js",
    "db:import-assessments": "node scripts/import-cs-assessments.js",
    "db:verify-assessments": "node scripts/verify-assessments.js",
    "test:ai-json-parser": "node scripts/test-ai-json-parser.js",
    "test:assessment-grading": "node scripts/test-deterministic-assessment.js",
    "test:course-finals": "node --test scripts/course-final-exam.test.js",
    "db:sync-courses": "node scripts/seed-courses.js --incremental",
    "db:import-practicals": "node scripts/import-practicals.js",
    "db:reset-practicals": "node scripts/reset-practicals.js",
    "test:assessment-parser": "node scripts/test-assessment-parser.js",
    "audio:generate": "node scripts/generate-narration-audio.js",
    "audio:map-voices": "node scripts/generate-course-voice-map.js",
    "db:migrate-learning-board-audio": "node scripts/migrate-learning-board-audio.js",
    "db:publish-learning-board-audio": "node scripts/publish-learning-board-audio-metadata.js",
    "db:migrate-course-finals": "node scripts/migrate-course-finals.js",
    "db:import-course-finals": "node scripts/import-course-finals.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.11.4",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.4.8",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
