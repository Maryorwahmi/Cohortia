# Public URL of the backend. Used to build the Google OAuth callback URL.
API_PUBLIC_URL=http://localhost:3001

# URL the OAuth callback redirects back to after authentication.
# Public frontend base URL; used for branded email logos and links in production.
FRONTEND_URL=http://localhost:5173

# Brevo newsletter delivery. Keep the API key private on the backend.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_SENDER_EMAIL=hello@cohortia.study
BREVO_SENDER_NAME=Cohortia

# Generate a unique secret with at least 32 random bytes; required to start the API.
JWT_SECRET=

# Shared only by the API proxy Worker and backend; required on Render or when NODE_ENV=production.
COHORTIA_API_ORIGIN_SECRET=

# Private password for the initial alpha administrator; use at least 12 characters.
ADMIN_BOOTSTRAP_PASSWORD=
# Optional login email for the alpha administrator.
ALPHA_ADMIN_EMAIL=admin@cohortia.local
# Set to true only when intentionally resetting an existing alpha admin password.
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# Cloudflare isolated native practical executor. Keep the secret only on Render/backend.
COHORTIA_SANDBOX_EXECUTOR_URL=
COHORTIA_SANDBOX_EXECUTOR_SECRET=

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Random 32+ character secret used to encrypt authenticator-app secrets at rest.
TOTP_ENCRYPTION_KEY=
