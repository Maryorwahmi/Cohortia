{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-clang-assets.mjs",
    "predev:share": "node scripts/copy-clang-assets.mjs",
    "dev": "vite --configLoader runner",
    "dev:share": "vite --host 0.0.0.0 --configLoader runner",
    "prebuild": "node scripts/copy-clang-assets.mjs",
    "build": "node scripts/build-public-content.mjs && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test:generated-content-security": "node --experimental-strip-types --test src/lib/generatedContentSanitizer.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@live-codes/clang-wasm": "^0.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.46.2",
    "@rollup/rollup-win32-x64-msvc": "^4.46.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.14",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.14"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
