PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
DATABASE_URL=file:./cohortia.db

# Gemini API key
# Get this from https://aistudio.google.com/app/apikey
# Use the key format provided by the provider.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_API_KEY_1=replace-with-your-gemini-api-key
GEMINI_API_KEY_2=replace-with-your-gemini-api-key
GEMINI_API_KEY_3=replace-with-your-gemini-api-key
GEMINI_API_KEY_4=replace-with-your-gemini-api-key
GEMINI_API_KEY_5=replace-with-your-gemini-api-key
GEMINI_API_KEY_6=replace-with-your-gemini-api-key
GEMINI_API_KEY_7=replace-with-your-gemini-api-key
GEMINI_API_KEY_8=replace-with-your-gemini-api-key
GEMINI_API_KEY_9=replace-with-your-gemini-api-key

pexels_api_key=replace-with-your-pexels-api-key


# Optional: override the Gemini model
# Default is gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Maximum time allowed for an individual key request before it is abandoned.
# GEMINI_REQUEST_TIMEOUT_MS=15000

# Kimi / Moonshot AI API key
# Get yours from https://platform.moonshot.cn/
Kimi_Key=replace-with-your-kimi-api-key