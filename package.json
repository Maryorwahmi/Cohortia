{
  "name": "cohortia-app",
  "private": true,
  "version": "1.0.0",
  "description": "Cohortia frontend and backend application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
